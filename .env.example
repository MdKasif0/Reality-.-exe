# Reality.exe Environment Variables Example
# Copy this file to .env and insert your API keys

# Gemini API Key (Recommended for vision multimodal intelligence)
# Obtain a free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Optional OpenAI Compatible Provider
VITE_OPENAI_API_KEY=
OPENAI_API_KEY=

# Server Proxy Port (if running separate proxy server)
PORT=3001
